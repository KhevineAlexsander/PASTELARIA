# Variáveis de Ambiente — Ki-Delícia Pastelaria
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório.

# ── Supabase (para versão futura com banco de dados real) ──
# Obtenha esses valores em: https://app.supabase.com → Settings → API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# ATENÇÃO: A chave service_role é SECRETA e nunca deve ser usada no frontend.
# Use-a apenas em funções de servidor (Edge Functions, etc).
# SUPABASE_SERVICE_ROLE_KEY=NUNCA_EXPONHA_ESSA_CHAVE_NO_FRONTEND

# ── Configurações da loja (opcionais, atualmente gerenciadas pelo painel) ──
# STORE_NAME=Ki-Delícia Pastelaria
# STORE_WHATSAPP=(99) 98443-6545
